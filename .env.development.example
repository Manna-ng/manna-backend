# Manna development environment template
# SAFE TEMPLATE ONLY - no real credentials.
# Real Staging/Production secrets belong in Vercel.
# Do NOT set NODE_ENV=staging. Use APP_ENV for Manna environment identity.

# --- environment_identity ---
APP_ENV="development"

# --- database ---
DATABASE_URL="<DEVELOPMENT_NEON_DATABASE_URL__neondb>"
DIRECT_URL="<DEVELOPMENT_NEON_DIRECT_URL__neondb>"
SHADOW_DATABASE_URL="<DEVELOPMENT_NEON_SHADOW_DATABASE_URL__manna_shadow>"

# --- public_build_time ---
NEXT_PUBLIC_APP_URL="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_API_KEY="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_APP_ID="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="<SET_DEVELOPMENT_PUBLIC_VALUE>"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<SET_DEVELOPMENT_PUBLIC_VALUE>"
